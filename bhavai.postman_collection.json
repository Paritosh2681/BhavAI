{
  "info": {
    "name": "BhavAI API & MCP Collection",
    "description": "PayPal AI Hackathon 2026 — BhavAI Agent-Ready Commerce Platform API contracts and MCP endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "apiKey", "value": "bvk_sample_key", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Public Storefronts",
      "item": [
        {
          "name": "List Stores",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/public/stores" }
        },
        {
          "name": "Get Aaranya Crafts Store",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/public/stores/aaranya-crafts" }
        },
        {
          "name": "Search Market Products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/public/market/products?search=diya&currency=USD" }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as Demo Seller",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"seller@bhavai.demo\",\n  \"password\": \"BhavAI!2026\"\n}" }
          }
        },
        {
          "name": "Get Current Session",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        }
      ]
    },
    {
      "name": "Negotiations",
      "item": [
        {
          "name": "Create Negotiation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/negotiations",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"prod_sample_diya\",\n  \"quantity\": 50,\n  \"unitPrice\": 8.00,\n  \"budgetTotal\": 400.00,\n  \"message\": \"Looking for 50 diyas within $400 budget.\"\n}" }
          }
        },
        {
          "name": "Advance Agent Step",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/negotiations/{{negotiationId}}/step" }
        },
        {
          "name": "Confirm Deal",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/negotiations/{{negotiationId}}/confirm" }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment for Deal",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/payments/deals/{{negotiationId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"origin\": \"http://localhost:5173\"\n}" }
          }
        },
        {
          "name": "Capture PayPal Order",
          "request": { "method": "POST", "url": "{{baseUrl}}/api/payments/{{paymentId}}/capture" }
        }
      ]
    },
    {
      "name": "Model Context Protocol (MCP)",
      "item": [
        {
          "name": "List Tools (JSON-RPC)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/mcp",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\",\n  \"params\": {}\n}"
            }
          }
        },
        {
          "name": "Call search_products",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/mcp",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"search_products\",\n    \"arguments\": { \"query\": \"diya\" }\n  }\n}"
            }
          }
        }
      ]
    }
  ]
}

