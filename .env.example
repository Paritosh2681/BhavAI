# BhavAI — Agent-Ready Commerce Platform
# Environment Configuration Template

# Runtime & URLs
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database
# If DATABASE_URL is omitted, BhavAI automatically uses zero-dependency embedded PostgreSQL (PGlite).
DATABASE_URL=
# PGLITE_DIR=./data/bhavai.db

# Authentication
# Dev mode generates a deterministic fallback; production requires a secret.
JWT_SECRET=bhavai_production_jwt_secret_change_in_production_min_32_chars
COOKIE_SECURE=false

# Google Gemini API (Language layer for natural language generation)
# If omitted, BhavAI falls back gracefully to deterministic policy text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PayPal Developer Sandbox (Orders v2 API)
# Required for cross-border transactions.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Model Context Protocol (MCP)
# Optional deployment secret to gate the /mcp endpoint. Users authenticate with their own bvk_ keys.
MCP_API_KEY=

# Channel3 Product Enrichment (Optional sponsor integration)
# Used for structured catalog taxonomy and attribute enrichment.
CHANNEL3_API_KEY=

# Seed Configuration
SEED_DEMO=true
LOG_LEVEL=info

